# Local only (Docker). In AWS the master values come from deploy/env/<stage>.yml.

# Superuser of the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Admin with the RDS master privileges (CREATEROLE, CREATEDB), created on the first
# start by scripts/database/. The db-provisioner and the tests connect with it.
MASTER_DB_HOST=db
MASTER_DB_PORT=5432
MASTER_DB_USER=provisioner_admin
MASTER_DB_PASSWORD=change-me
MASTER_DB_NAME=postgres
